# mica 配置。MULTICA_* 前缀贴生产 multiCa 命名,但 mica 本身不依赖 multica CLI。
# 默认 agent CLI(PATH 上须已安装并登录);s03 起生效。
MULTICA_DEFAULT_CLI=claude
# daemon 轮询间隔(秒)
MULTICA_POLL_INTERVAL=2
# 运行时数据目录(issues.jsonl / sessions / skills)
MULTICA_DATA_DIR=./workspace
# 实时 WebSocket 端口
MULTICA_WS_PORT=8787
# 看板端口
MULTICA_WEB_PORT=8000
# 本 daemon 代表的 agent id
MULTICA_AGENT_ID=agent-1
