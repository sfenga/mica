# mica 本地控制台配置。MULTICA_* 前缀贴生产 multiCa 命名,但 mica 本身不依赖 multica CLI。
# 默认真实 agent CLI(PATH 上须已安装并登录);s99 的 ClaudeCliRunner 会读取。
MULTICA_DEFAULT_CLI=claude

# 运行时数据目录(issues.jsonl / sessions / skills)
MULTICA_DATA_DIR=./workspace

# 看板端口
MULTICA_WEB_PORT=8000

# 后台 daemon 空闲时的兜底轮询间隔(秒)
MULTICA_POLL_INTERVAL=0.5

# s99 runtime 同时可执行的 task 数。默认 1,便于观察 slot-before-claim。
MULTICA_MAX_SLOTS=1

# autopilot 默认派单 agent id
MULTICA_AGENT_ID=agent-1
