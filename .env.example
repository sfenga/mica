# Mica 正式后端配置。API 与 Daemon 通过 PostgreSQL 协作。
MICA_STORAGE=postgres
DATABASE_URL=postgresql://mica:mica@127.0.0.1:5432/mica
MICA_API_HOST=127.0.0.1
MICA_API_PORT=8000
MICA_LOG_LEVEL=INFO
MICA_RUNTIME_ID=local
MICA_RUNTIME_NAME=Local Runtime
MICA_DAEMON_ID=daemon-local-1
MICA_DEFAULT_PROVIDER=codex
MICA_MAX_SLOTS=2
MICA_RUNTIME_DISCOVERY_INTERVAL=120
# 可选：覆盖自动发现到的 CLI 路径。
MICA_CODEX_PATH=
MICA_CLAUDE_PATH=
MICA_PI_PATH=
MICA_POLL_INTERVAL=2
MICA_LEASE_SECONDS=120
MICA_HEARTBEAT_SECONDS=30
MICA_WORKTREE_ROOT=~/.mica/worktrees
# 未关联项目的本地 Agent 使用的隔离空工作目录。
MICA_WORKSPACE_ROOT=~/.mica/workspaces
# 自动发现 Git 项目的根目录；多个目录使用系统路径分隔符连接（macOS/Linux 为冒号）。
MICA_PROJECT_ROOTS=/Users/you/code
MICA_CHANNEL_POLL_INTERVAL=2
MICA_CHANNEL_MAX_ATTEMPTS=8

# PostgreSQL 模式默认由独立 mica-daemon 进程执行任务；设为 1 可嵌入 API 进程。
MICA_EMBEDDED_DAEMON=0

# 飞书应用配置。四项均设置后才启用 /api/integrations/feishu/events。
# Encrypt Key 用于 SDK 的事件解密与签名校验；密钥只从环境变量读取。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
FEISHU_DEFAULT_AGENT_ID=local-assistant
FEISHU_MAX_CLOCK_SKEW_SECONDS=300
# 设置为 local 可让飞书与当前本地 Web 控制台使用相同 Workspace/Squad。
FEISHU_WORKSPACE_ID=local
